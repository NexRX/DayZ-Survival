{
  "tasks": {
    "dayz": "deno run -A src/main.ts",
    "up": "deno run -A src/main.ts up",
    "up-simple": "deno run -A src/main.ts up-simple",
    "mods": "deno run -A src/main.ts mods",
    "install": "deno run -A src/main.ts install",
    "login": "deno run -A src/main.ts login",
    "config": "deno run -A src/main.ts config",
    "resolve": "deno run -A src/main.ts resolve",
    "search": "deno run -A src/main.ts search",
    "status": "deno run -A src/main.ts status",
    "admin": "deno run -A src/main.ts admin",
    "wipe": "deno run -A src/main.ts wipe",
    "build-serverpack": "deno run -A src/main.ts build-serverpack",

    "verify-serverpack": "deno run -A src/main.ts verify-serverpack",
    "build-custom-map": "deno run -A src/main.ts build-custom-map",
    "sync-editor": "deno run -A src/main.ts sync-editor",
    "audit-market": "deno run -A src/main.ts audit-market",
    "clear-quests": "deno run -A src/main.ts clear-quests",
    "check": "deno check src/main.ts",
    "fmt": "deno fmt src/",
    "lint": "deno lint src/",
    "classNames": "deno run -A tools/dayz-classnames.ts"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
