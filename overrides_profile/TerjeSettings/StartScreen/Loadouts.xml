<Loadouts>
	<Loadout id="survivor" displayName="Survivor">
		<Items>
		    <Selector type="SINGLE" displayName="Weapon">
                <Item classname="PipeWrench" position="Melee" quickbar="0" />
                <Item classname="BaseballBat" position="Melee" quickbar="0" />
                <Item classname="Pipe" position="Melee" quickbar="0" />
		    </Selector>
			<!-- Clothes -->
			<Selector type="SINGLE" displayName="Shirt">
                <Item classname="TShirt_Beige" />
                <Item classname="TShirt_Black" />
                <Item classname="TShirt_Blue" />
                <Item classname="TShirt_Green" />
                <Item classname="TShirt_Grey" />
                <Item classname="TShirt_OrangeWhiteStripes" />
                <Item classname="TShirt_Red" />
                <Item classname="TShirt_RedBlackStripes" />
                <Item classname="TShirt_White" />
			</Selector>
			<Selector type="SINGLE" displayName="Pants">
			    <Item classname="CanvasPants_Beige" />
			    <Item classname="CanvasPants_Blue" />
			    <Item classname="CanvasPants_Grey" />
			    <Item classname="CanvasPants_Red" />
			    <Item classname="CanvasPants_Violet" />
			</Selector>
			<Selector type="SINGLE" displayName="Shoes">
			    <Item classname="AthleticShoes_Black" />
			    <Item classname="AthleticShoes_Blue" />
			    <Item classname="AthleticShoes_Brown" />
			    <Item classname="AthleticShoes_Green" />
			    <Item classname="AthleticShoes_Grey" />
			</Selector>
			<Selector type="SINGLE" displayName="Armband">
			    <Item classname="Armband_Black" />
			    <Item classname="Armband_Blue" />
			    <Item classname="Armband_Green" />
			    <Item classname="Armband_Orange" />
			    <Item classname="Armband_Pink" />
			    <Item classname="Armband_Red" />
			    <Item classname="Armband_White" />
			    <Item classname="Armband_Yellow" />
			</Selector>
			<!-- Gear -->
			<Item classname="TRQ_DecoyGrenade" quickbar="1" position="@Cargo" />
			<Item classname="ChernarusMap" quickbar="2" position="@Cargo" />
			<Item classname="Rag" count="4" quickbar="4" position="@Cargo" />
			<Item classname="TerjeDosimetrDpg05" position="@Cargo">
			    <Item classname="Battery9V" />
			</Item>
			<Selector type="RANDOM">
				<Item classname="Plum" position="@Cargo" />
				<Item classname="Apple" position="@Cargo" />
				<Item classname="Pear" position="@Cargo" />
				<Item classname="Tomato" position="@Cargo" />
				<Item classname="Potato" position="@Cargo" />
			</Selector>
			<Selector type="RANDOM">
                <Item classname="Chemlight_Red" position="@Cargo" />
                <Item classname="Chemlight_Green" position="@Cargo" />
                <Item classname="Chemlight_Yellow" position="@Cargo" />
                <Item classname="Chemlight_White" position="@Cargo" />
			</Selector>
		</Items>
	</Loadout>
</Loadouts>
