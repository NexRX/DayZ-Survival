# ---------------------------------------------------------------------------
# Settings for dayz.sh
# ---------------------------------------------------------------------------
# You normally DON'T edit this by hand — `./dayz.sh` prompts for these and
# writes them to `.env` for you. This file just documents the keys.
# Your Steam PASSWORD is never stored here; it's used once to cache a session.
# ---------------------------------------------------------------------------

# Steam account that OWNS DayZ (required for server + mod downloads).
STEAM_USER=

# Server browser name.
SERVER_NAME="DayZ Survival | Expansion"

# Player join password ("" = open) and admin/RCON password.
JOIN_PASSWORD=
ADMIN_PASSWORD=

MAXPLAYERS=60

# UDP ports.
PORT=2302
QUERY_PORT=2305

# Copy mods into the server dir and lowercase all paths (1) — needed on Linux —
# or symlink workshop content directly (0, faster, less disk).
LOWERCASE_MODS=1

# Optional Steam Web API key — only used by './dayz.sh resolve' to verify mod
# IDs. Not used for downloads.
STEAM_API_KEY=

# Extra launch parameters appended to the server command line.
EXTRA_PARAMS="-dologs -adminlog -netlog -freezecheck"
